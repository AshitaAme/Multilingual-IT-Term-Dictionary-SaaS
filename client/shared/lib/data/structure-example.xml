            <termEntry id="10000_74213_74225">
                <langSet xml:lang="en-US">
                    <descripGrp>
                        <descrip type="definition">A computer, software program, network, or other computer equipment that remains in use after a business or organization installs new systems. Compatibility with legacy systems is an important consideration when a new version is installed. For example, will a new spreadsheet software release be able to read the existing business records without expensive and time-consuming conversion to a new format? Legacy systems in many organizations are based on mainframe computers, which may be either augmented or slowly replaced by client/server architectures.</descrip>
                    </descripGrp>
                    <ntig>
                        <termGrp>
                            <term id="74213">legacy system</term>
                            <termNote type="partOfSpeech">Noun</termNote>
                            <termNote type="grammaticalNumber">Singular</termNote>
                        </termGrp>
                    </ntig>
                </langSet>
                <langSet xml:lang="zh-Hans">
                    <ntig>
                        <termGrp>
                            <term id="74225">旧系统</term>
